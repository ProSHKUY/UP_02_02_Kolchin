<Window x:Class="Kolchin_up_02._02.OrderEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ООО «ЧитайГород» — Заказ"
        Height="752"
        Width="850"
        MinHeight="600"
        MinWidth="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Comic Sans MS"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0"
                Background="{StaticResource SecondaryBackgroundBrush}"
                Padding="14"
                CornerRadius="6"
                Margin="0,0,0,14">
            <TextBlock x:Name="WindowHeaderTextBlock"
                       Text="Добавление заказа"
                       FontSize="21"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Основные данные заказа -->
                <TextBlock Text="Информация о заказе"
                           FontSize="17"
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Grid.Column="0"
                                Margin="0,0,12,12">
                        <TextBlock Text="Дата заказа"
                                   Margin="0,0,0,5"/>
                        <DatePicker x:Name="OrderDatePicker"
                                    SelectedDateFormat="Short"
                                    Height="32"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0"
                                Grid.Column="1"
                                Margin="0,0,0,12">
                        <TextBlock Text="Дата доставки"
                                   Margin="0,0,0,5"/>
                        <DatePicker x:Name="DeliveryDatePicker"
                                    SelectedDateFormat="Short"
                                    Height="32"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                Grid.Column="0"
                                Margin="0,0,12,12">
                        <TextBlock Text="Статус заказа"
                                   Margin="0,0,0,5"/>
                        <ComboBox x:Name="StatusComboBox"
                                  Height="32"
                                  DisplayMemberPath="StatusName"
                                  SelectedValuePath="StatusId"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                Grid.Column="1"
                                Margin="0,0,0,12">
                        <TextBlock Text="Пункт выдачи"
                                   Margin="0,0,0,5"/>
                        <ComboBox x:Name="PickupPointComboBox"
                                  Height="32"
                                  DisplayMemberPath="Address"
                                  SelectedValuePath="PickupPointId"/>
                    </StackPanel>
                </Grid>

                <Separator Margin="0,5,0,14"/>

                <!-- Добавление товаров -->
                <TextBlock Text="Состав заказа"
                           FontSize="17"
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="ProductComboBox"
                              Grid.Column="0"
                              Height="34"
                              Margin="0,0,10,0"
                              DisplayMemberPath="ProductName"
                              SelectedValuePath="Article"
                              VerticalContentAlignment="Center"/>

                    <TextBox x:Name="QuantityTextBox"
                             Grid.Column="1"
                             Height="34"
                             Text="1"
                             VerticalContentAlignment="Center"
                             TextAlignment="Center"
                             Margin="0,0,10,0"/>

                    <Button Grid.Column="2"
                            Content="Добавить"
                            Height="34"
                            Padding="14,0"
                            Click="AddItemButton_Click"/>
                </Grid>

                <DataGrid x:Name="OrderItemsDataGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          SelectionMode="Single"
                          Height="230"
                          Margin="0,0,0,10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Артикул"
                                            Binding="{Binding ProductArticle}"
                                            Width="140"/>
                        <DataGridTextColumn Header="Наименование товара"
                                            Binding="{Binding ProductName}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Количество"
                                            Binding="{Binding Quantity}"
                                            Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Button x:Name="RemoveItemButton"
                        Content="Удалить выбранный товар"
                        HorizontalAlignment="Right"
                        Padding="12,6"
                        Margin="0,0,0,12"
                        Click="RemoveItemButton_Click"/>

            </StackPanel>
        </ScrollViewer>

        <!-- Нижние кнопки -->
        <Border Grid.Row="2"
                Background="{StaticResource SecondaryBackgroundBrush}"
                Padding="12"
                CornerRadius="6"
                Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Сохранить"
                        Padding="20,9"
                        Margin="0,0,10,0"
                        Click="SaveButton_Click"/>

                <Button Content="Отмена"
                        Padding="20,9"
                        Click="CancelButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
