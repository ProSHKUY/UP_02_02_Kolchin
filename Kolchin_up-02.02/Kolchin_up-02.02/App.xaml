<Application x:Class="Kolchin_up_02._02.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Kolchin_up_02._02"
             StartupUri="Avtoriz.xaml">
    <Application.Resources>
        <!--Цвета-->
        <SolidColorBrush x:Key="BackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="#ABCFCE"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#546F94"/>
        <SolidColorBrush x:Key="HighDiscountBrush" Color="#23E1EF"/>
        <SolidColorBrush x:Key="OutOfStockBrush" Color="#D3D3D3"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#000000"/>

        <!--стиль кнопок-->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Comic Sans MS"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Application.Resources>
</Application>