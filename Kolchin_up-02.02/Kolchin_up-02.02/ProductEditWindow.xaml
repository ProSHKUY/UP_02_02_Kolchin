<Window x:Class="Kolchin_up_02._02.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kolchin_up_02._02"
        mc:Ignorable="d"

        Title="ООО «ЧитайГород» — Добавление / редактирование товара"
        Icon="pack://application:,,,/Resources/icon.ico"
        Height="740"
        Width="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Comic Sans MS"
        Foreground="{StaticResource TextPrimaryBrush}">

    <DockPanel>

        <!-- Шапка окна -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource SecondaryBackgroundBrush}"
                Padding="14">

            <TextBlock x:Name="WindowHeaderTextBlock"
                       Text="Добавление нового товара"
                       FontSize="20"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource TextPrimaryBrush}"/>

        </Border>

        <!-- Нижняя панель кнопок -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource SecondaryBackgroundBrush}"
                Padding="12">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Content="Сохранить"
                        Width="130"
                        Height="36"
                        FontWeight="Bold"
                        Margin="0,0,10,0"
                        Click="SaveButton_Click"/>

                <Button Content="Назад"
                        Width="110"
                        Height="36"
                        Background="{StaticResource BackgroundBrush}"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Click="CancelButton_Click"/>

            </StackPanel>
        </Border>

        <!-- Основная форма -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="20">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Левая колонка: фотография товара -->
                <StackPanel Grid.Column="0"
                            Margin="0,0,20,0">

                    <TextBlock Text="Фото товара (до 300×200):"
                               FontSize="13"
                               FontWeight="Bold"
                               Margin="0,0,0,6"/>

                    <Border Width="200"
                            Height="150"
                            BorderBrush="{StaticResource PrimaryBrush}"
                            BorderThickness="1.5"
                            Background="{StaticResource BackgroundBrush}"
                            Margin="0,0,0,10">

                        <Image x:Name="ProductPreviewImage"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>

                    </Border>

                    <Button Content="Загрузить фото"
                            Height="34"
                            Click="SelectPhotoButton_Click"/>

                    <TextBlock x:Name="PhotoFileNameTextBlock"
                               Text="Файл не выбран"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0"
                               Foreground="{StaticResource TextPrimaryBrush}"/>

                </StackPanel>

                <!-- Правая колонка: атрибуты товара -->
                <StackPanel Grid.Column="1">

                    <!-- Артикул -->
                    <TextBlock Text="Артикул *"
                               FontSize="13"
                               Margin="0,0,0,3"/>

                    <TextBox x:Name="ArticleTextBox"
                             Height="32"
                             Padding="5"
                             VerticalContentAlignment="Center"
                             Margin="0,0,0,10"/>

                    <!-- Наименование -->
                    <TextBlock Text="Наименование товара *"
                               FontSize="13"
                               Margin="0,0,0,3"/>

                    <TextBox x:Name="NameTextBox"
                             Height="32"
                             Padding="5"
                             VerticalContentAlignment="Center"
                             Margin="0,0,0,10"/>

                    <!-- Категория -->
                    <TextBlock Text="Категория товара *"
                               FontSize="13"
                               Margin="0,0,0,3"/>

                    <ComboBox x:Name="CategoryComboBox"
                              Height="32"
                              DisplayMemberPath="CategoryName"
                              SelectedValuePath="CategoryId"
                              Margin="0,0,0,10"/>

                    <!-- Производитель -->
                    <TextBlock Text="Производитель (издательство) *"
                               FontSize="13"
                               Margin="0,0,0,3"/>

                    <ComboBox x:Name="ManufacturerComboBox"
                              Height="32"
                              DisplayMemberPath="ManufacturerName"
                              SelectedValuePath="ManufacturerId"
                              Margin="0,0,0,10"/>

                    <!-- Поставщик -->
                    <TextBlock Text="Поставщик (автор) *"
                               FontSize="13"
                               Margin="0,0,0,3"/>

                    <ComboBox x:Name="SupplierComboBox"
                              Height="32"
                              DisplayMemberPath="SupplierName"
                              SelectedValuePath="SupplierId"
                              Margin="0,0,0,10"/>

                    <!-- Цена и единица измерения -->
                    <Grid Margin="0,0,0,10">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">

                            <TextBlock Text="Цена (руб.) *"
                                       FontSize="13"
                                       Margin="0,0,0,3"/>

                            <TextBox x:Name="PriceTextBox"
                                     Height="32"
                                     Padding="5"
                                     VerticalContentAlignment="Center"/>

                        </StackPanel>

                        <StackPanel Grid.Column="2">

                            <TextBlock Text="Единица измерения *"
                                       FontSize="13"
                                       Margin="0,0,0,3"/>

                            <ComboBox x:Name="UnitComboBox"
                                      Height="32"
                                      DisplayMemberPath="UnitName"
                                      SelectedValuePath="UnitId"/>

                        </StackPanel>

                    </Grid>

                    <!-- Количество и скидка -->
                    <Grid Margin="0,0,0,10">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">

                            <TextBlock Text="Количество на складе *"
                                       FontSize="13"
                                       Margin="0,0,0,3"/>

                            <TextBox x:Name="StockTextBox"
                                     Height="32"
                                     Padding="5"
                                     VerticalContentAlignment="Center"/>

                        </StackPanel>

                        <StackPanel Grid.Column="2">

                            <TextBlock Text="Действующая скидка (%)"
                                       FontSize="13"
                                       Margin="0,0,0,3"/>

                            <TextBox x:Name="DiscountTextBox"
                                     Text="0"
                                     Height="32"
                                     Padding="5"
                                     VerticalContentAlignment="Center"/>

                        </StackPanel>

                    </Grid>

                    <!-- Описание -->
                    <TextBlock Text="Описание товара"
                               FontSize="13"
                               Margin="0,0,0,3"/>

                    <TextBox x:Name="DescriptionTextBox"
                             Height="75"
                             Padding="5"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"/>

                </StackPanel>
            </Grid>
        </ScrollViewer>

    </DockPanel>
</Window>
