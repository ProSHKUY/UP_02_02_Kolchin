<Window x:Class="Kolchin_up_02._02.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kolchin_up_02._02"
        mc:Ignorable="d"
        Title="ООО «ЧитайГород» — Каталог товаров (Гость)"
        Icon="pack://application:,,,/Resources/icon.ico"
        Height="720" Width="1050"
        MinHeight="500" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Comic Sans MS">

    <DockPanel>
        <!-- Верхняя панель гостевого режима -->
        <Border DockPanel.Dock="Top" Background="{StaticResource SecondaryBackgroundBrush}" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" Source="pack://application:,,,/Resources/icon.png" Height="45" Stretch="Uniform" Margin="0,0,12,0"/>

                <TextBlock Grid.Column="1"
                           Text="ООО «ЧитайГород» — Каталог книг (Гость)"
                           FontSize="20"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="2"
                        Content="Выйти"
                        Padding="18,8"
                        Click="ExitButton_Click"/>
            </Grid>
        </Border>

        <!-- Список товаров -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
            <ItemsControl ItemsSource="{Binding Products}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,10"
                                BorderBrush="#546F94"
                                BorderThickness="1.5"
                                Padding="12"
                                Background="{Binding CardBackground}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>

                                <!-- Фото товара -->
                                <Border Grid.Column="0" Width="135" Height="135" BorderBrush="#ABCFCE" BorderThickness="1" Background="White">
                                    <Image Source="{Binding ImageSource}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>

                                <!-- Информация о книге -->
                                <StackPanel Grid.Column="1" Margin="15,0" VerticalAlignment="Center">
                                    <TextBlock FontSize="15" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,4">
                                        <Run Text="{Binding CategoryName, Mode=OneWay}"/>
                                        <Run Text=" | "/>
                                        <Run Text="{Binding Name, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Description, StringFormat='Описание товара: {0}'}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding ManufactureName, StringFormat='Производитель: {0}'}" FontSize="13" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding SupplierName, StringFormat='Поставщик: {0}'}" FontSize="13" Margin="0,0,0,2"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <TextBlock Text="Цена: " FontSize="13"/>
                                        <TextBlock Text="{Binding BasePrice, StringFormat={}{0:N2} руб.}"
                                                   FontSize="13"
                                                   Foreground="Red"
                                                   TextDecorations="Strikethrough"
                                                   Visibility="{Binding OldPriceVisibility}"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding DiscountPrice, StringFormat={}{0:N2} руб.}"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="Black"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding UnitName, StringFormat='Единица измерения: {0}'}" FontSize="13" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding StockQuantity, StringFormat='Количество на складе: {0}'}" FontSize="13"/>
                                </StackPanel>

                                <!-- Действующая скидка -->
                                <Border Grid.Column="2" BorderBrush="#546F94" BorderThickness="1,0,0,0" Padding="8">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="Действующая" FontSize="13" HorizontalAlignment="Center"/>
                                        <TextBlock Text="скидка" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                        <TextBlock Text="{Binding DiscountPercent, StringFormat={}{0:0.##}%}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
