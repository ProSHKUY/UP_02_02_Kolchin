<Window x:Class="Kolchin_up_02._02.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kolchin_up_02._02"
        mc:Ignorable="d"
        Title="ООО «ЧитайГород» — Список заказов"
        Icon="pack://application:,,,/Resources/icon.ico"
        Height="680"
        Width="980"
        MinHeight="500"
        MinWidth="800"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Comic Sans MS"
        Foreground="{StaticResource TextPrimaryBrush}">

    <DockPanel>

        <!-- Шапка окна -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource SecondaryBackgroundBrush}"
                Padding="12">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Логотип -->
                <Image Grid.Column="0"
                       Source="pack://application:,,,/Resources/icon.png"
                       Height="45"
                       Stretch="Uniform"
                       Margin="0,0,12,0"/>

                <!-- Название -->
                <TextBlock Grid.Column="1"
                           Text="ООО «ЧитайГород» — Заказы"
                           FontSize="20"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <!-- Кнопки -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Button x:Name="AddOrderButton"
                            Content="Добавить заказ"
                            Padding="14,8"
                            Margin="0,0,10,0"
                            Visibility="Collapsed"
                            Click="AddOrderButton_Click"/>

                    <Button Content="Назад"
                            Padding="18,8"
                            Click="BackButton_Click"/>

                </StackPanel>
            </Grid>
        </Border>

        <!-- Список заказов -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Padding="15">

            <ItemsControl x:Name="OrdersItemsControl">

                <ItemsControl.ItemTemplate>
                    <DataTemplate>

                        <Border Margin="0,0,0,12"
                                BorderBrush="{StaticResource PrimaryBrush}"
                                BorderThickness="1.5"
                                Padding="14"
                                Background="{StaticResource BackgroundBrush}"
                                Cursor="Hand"
                                MouseLeftButtonUp="OrderCard_MouseLeftButtonUp">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="180"/>
                                </Grid.ColumnDefinitions>

                                <!-- Левая часть карточки -->
                                <StackPanel Grid.Column="0"
                                            Margin="0,0,15,0"
                                            VerticalAlignment="Center">

                                    <TextBlock Text="{Binding ArticlesSummary}"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,6"/>

                                    <TextBlock Text="{Binding StatusName, StringFormat='Статус заказа: {0}'}"
                                               FontSize="14"
                                               Margin="0,0,0,3"/>

                                    <TextBlock Text="{Binding PickupAddress, StringFormat='Адрес пункта выдачи: {0}'}"
                                               FontSize="14"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,3"/>

                                    <TextBlock Text="{Binding OrderDateText, StringFormat='Дата заказа: {0}'}"
                                               FontSize="14"/>

                                </StackPanel>

                                <!-- Правая часть карточки -->
                                <Border Grid.Column="1"
                                        BorderBrush="{StaticResource PrimaryBrush}"
                                        BorderThickness="1,0,0,0"
                                        Padding="10">

                                    <StackPanel VerticalAlignment="Center"
                                                HorizontalAlignment="Center">

                                        <TextBlock Text="Дата доставки:"
                                                   FontSize="13"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,4"/>

                                        <TextBlock Text="{Binding DeliveryDateText}"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"/>

                                        <!-- Кнопка удаления -->
                                        <Button Content="Удалить"
                                                Padding="12,4"
                                                FontSize="12"
                                                Background="{StaticResource PrimaryBrush}"
                                                Margin="0,10,0,0"
                                                Visibility="{Binding DeleteButtonVisibility}"
                                                Tag="{Binding}"
                                                Click="DeleteOrderButton_Click"/>

                                    </StackPanel>
                                </Border>

                            </Grid>
                        </Border>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>
        </ScrollViewer>

    </DockPanel>
</Window>
