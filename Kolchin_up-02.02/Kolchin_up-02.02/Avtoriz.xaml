<Window x:Class="Kolchin_up_02._02.Avtoriz"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kolchin_up_02._02"
        mc:Ignorable="d"
        Title="ООО «ЧитайГород» — Авторизация"
        Icon="pack://application:,,,/Resources/icon.ico"
        Height="542"
        Width="430"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Comic Sans MS">

    <Window.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#F4F6F6"/>
        <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="#ABCFCE"/>
    </Window.Resources>

    <DockPanel>

        <!-- Шапка с логотипом -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource SecondaryBackgroundBrush}"
                Padding="14">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">

                <Image Source="pack://application:,,,/Resources/icon.png"
                       Height="75"
                       Stretch="Uniform"
                       Margin="0,0,12,0" Width="133"/>

                <TextBlock Text="«ЧитайГород»"
                           FontSize="22"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

            </StackPanel>
        </Border>

        <!-- Форма авторизации -->
        <StackPanel Margin="40,25"
                    VerticalAlignment="Center">

            <TextBlock Text="Авторизация"
                       FontSize="20"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,18"/>

            <TextBlock Text="Логин:"
                       FontSize="14"
                       Margin="0,0,0,4"/>

            <TextBox x:Name="LoginTextBox"
                     Height="36"
                     FontSize="14"
                     Padding="6"
                     VerticalContentAlignment="Center"
                     Margin="0,0,0,14"/>

            <TextBlock Text="Пароль:"
                       FontSize="14"
                       Margin="0,0,0,4"/>

            <PasswordBox x:Name="PasswordBox"
                         Height="36"
                         FontSize="14"
                         Padding="6"
                         VerticalContentAlignment="Center"
                         Margin="0,0,0,22"/>

            <Button Content="Войти"
                    Height="40"
                    FontWeight="Bold"
                    Click="LoginButton_Click"
                    Margin="0,0,0,12"/>

            <Button Content="Войти как гость"
                    Height="36"
                    Background="{StaticResource SecondaryBackgroundBrush}"
                    Foreground="Black"
                    Click="GuestButton_Click"/>

        </StackPanel>

    </DockPanel>
</Window>
