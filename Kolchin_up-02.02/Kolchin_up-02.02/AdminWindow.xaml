<Window x:Class="Kolchin_up_02._02.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kolchin_up_02._02"
        mc:Ignorable="d"

        Title="ООО «ЧитайГород» — Каталог товаров (Администратор)"
        Icon="pack://application:,,,/Resources/icon.ico"
        Height="740"
        Width="1120"
        MinHeight="550"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Comic Sans MS"
        Foreground="{StaticResource TextPrimaryBrush}">

    <DockPanel>

        <!-- Шапка приложения -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource SecondaryBackgroundBrush}"
                Padding="12">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Логотип -->
                <Image Grid.Column="0"
                       Source="pack://application:,,,/Resources/icon.png"
                       Height="45"
                       Stretch="Uniform"
                       Margin="0,0,12,0"/>

                <!-- Название организации -->
                <TextBlock Grid.Column="1"
                           Text="ООО «ЧитайГород» — Управление каталогом книг"
                           FontSize="20"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}"/>

                <!-- Информация об администраторе -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <StackPanel Margin="0,0,15,0"
                                VerticalAlignment="Center">

                        <TextBlock x:Name="UserFullNameTextBlock"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Right"/>

                        <TextBlock Text="Роль: Администратор"
                                   FontSize="12"
                                   HorizontalAlignment="Right"/>

                    </StackPanel>

                    <Button Content="Выход"
                            Padding="18,8"
                            Click="LogoutButton_Click"/>

                </StackPanel>
            </Grid>
        </Border>

        <!-- Панель поиска, фильтрации и управления -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource BackgroundBrush}"
                Padding="12,8"
                BorderBrush="{StaticResource SecondaryBackgroundBrush}"
                BorderThickness="0,0,0,1">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Поиск -->
                <StackPanel Grid.Column="0"
                            Margin="0,0,10,0">

                    <TextBlock Text="Поиск (название, описание, автор, издатель, категория)"
                               FontSize="12"
                               Margin="0,0,0,4"/>

                    <TextBox x:Name="SearchTextBox"
                             Height="34"
                             Padding="6"
                             VerticalContentAlignment="Center"
                             TextChanged="SearchTextBox_TextChanged"/>

                </StackPanel>

                <!-- Фильтр по скидке -->
                <StackPanel Grid.Column="1"
                            Margin="0,0,10,0">

                    <TextBlock Text="Фильтр по скидке"
                               FontSize="12"
                               Margin="0,0,0,4"/>

                    <ComboBox x:Name="DiscountFilterComboBox"
                              Height="34"
                              SelectedIndex="0"
                              SelectionChanged="Filter_SelectionChanged">

                        <ComboBoxItem Content="Все диапазоны"/>
                        <ComboBoxItem Content="0-12,99%"/>
                        <ComboBoxItem Content="13-16,99%"/>
                        <ComboBoxItem Content="17% и более"/>

                    </ComboBox>
                </StackPanel>

                <!-- Сортировка -->
                <StackPanel Grid.Column="2"
                            Margin="0,0,10,0">

                    <TextBlock Text="Сортировка"
                               FontSize="12"
                               Margin="0,0,0,4"/>

                    <ComboBox x:Name="SortComboBox"
                              Height="34"
                              SelectedIndex="0"
                              SelectionChanged="Filter_SelectionChanged">

                        <ComboBoxItem Content="Без сортировки"/>
                        <ComboBoxItem Content="Цена: по возрастанию"/>
                        <ComboBoxItem Content="Цена: по убыванию"/>
                        <ComboBoxItem Content="Остаток: по возрастанию"/>
                        <ComboBoxItem Content="Остаток: по убыванию"/>

                    </ComboBox>
                </StackPanel>

                <!-- Кнопки администратора -->
                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Bottom">

                    <Button x:Name="AddProductButton"
        Content="Добавить товар"
        Height="34"
        Padding="14,0"
        Margin="0,0,8,0"
        Click="AddProductButton_Click"/>

                    <Button x:Name="OrdersButton"
                            Content="Заказы"
                            Height="34"
                            Padding="16,0" Click="OrdersButton_Click"/>

                </StackPanel>
            </Grid>
        </Border>

        <!-- Список товаров -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="12">

            <ItemsControl ItemsSource="{Binding Products}">

                <ItemsControl.ItemTemplate>
                    <DataTemplate>

                        <!-- Карточка товара -->
                        <Border Margin="0,0,0,10"
                                BorderBrush="{StaticResource PrimaryBrush}"
                                BorderThickness="1.5"
                                Padding="12"
                                Cursor="Hand"
                                MouseLeftButtonUp="ProductCard_MouseLeftButtonUp"
                                Background="{Binding CardBackground}">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>

                                <!-- Изображение товара -->
                                <Border Grid.Column="0"
                                        Width="135"
                                        Height="135"
                                        BorderBrush="{StaticResource SecondaryBackgroundBrush}"
                                        BorderThickness="1"
                                        Background="{StaticResource BackgroundBrush}">

                                    <Image Source="{Binding ImageSource}"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>

                                </Border>

                                <!-- Информация о товаре -->
                                <StackPanel Grid.Column="1"
                                            Margin="15,0"
                                            VerticalAlignment="Center">

                                    <TextBlock FontSize="15"
                                               FontWeight="Bold"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,4">

                                        <Run Text="{Binding CategoryName, Mode=OneWay}"/>
                                        <Run Text=" | "/>
                                        <Run Text="{Binding Name, Mode=OneWay}"/>

                                    </TextBlock>

                                    <TextBlock Text="{Binding Description, StringFormat='Описание товара: {0}'}"
                                               FontSize="13"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,3"/>

                                    <TextBlock Text="{Binding ManufactureName, StringFormat='Производитель: {0}'}"
                                               FontSize="13"
                                               Margin="0,0,0,2"/>

                                    <TextBlock Text="{Binding SupplierName, StringFormat='Поставщик: {0}'}"
                                               FontSize="13"
                                               Margin="0,0,0,2"/>

                                    <!-- Цена -->
                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,0,0,2">

                                        <TextBlock Text="Цена: "
                                                   FontSize="13"/>

                                        <TextBlock Text="{Binding BasePrice, StringFormat={}{0:N2} руб.}"
                                                   FontSize="13"
                                                   Foreground="Red"
                                                   TextDecorations="Strikethrough"
                                                   Visibility="{Binding OldPriceVisibility}"
                                                   Margin="0,0,8,0"/>

                                        <TextBlock Text="{Binding DiscountPrice, StringFormat={}{0:N2} руб.}"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>

                                    </StackPanel>

                                    <TextBlock Text="{Binding UnitName, StringFormat='Единица измерения: {0}'}"
                                               FontSize="13"
                                               Margin="0,0,0,2"/>

                                    <TextBlock Text="{Binding StockQuantity, StringFormat='Количество на складе: {0}'}"
                                               FontSize="13"/>

                                </StackPanel>

                                <!-- Скидка и удаление -->
                                <Border Grid.Column="2"
                                        BorderBrush="{StaticResource PrimaryBrush}"
                                        BorderThickness="1,0,0,0"
                                        Padding="8">

                                    <StackPanel VerticalAlignment="Center"
                                                HorizontalAlignment="Center">

                                        <TextBlock Text="Действующая"
                                                   FontSize="13"
                                                   HorizontalAlignment="Center"/>

                                        <TextBlock Text="скидка"
                                                   FontSize="13"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,4"/>

                                        <TextBlock Text="{Binding DiscountPercent, StringFormat={}{0:0.##}%}"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource PrimaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,8"/>

                                        <Button Content="Удалить"
                                                Padding="12,4"
                                                FontSize="12"
                                                Background="#C0392B"
                                                Tag="{Binding}"
                                                Click="DeleteProductButton_Click"/>

                                    </StackPanel>
                                </Border>

                            </Grid>
                        </Border>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>
        </ScrollViewer>

    </DockPanel>
</Window>
